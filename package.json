{
  "name": "nasa_backend",
  "version": "1.0.0",
  "description": "NASA Wellness Backend API System with Tammy AI Virtual Pet",
  "main": "dist/src/app.js",
  "scripts": {
    "predev": "npm run lint:fix && npm run typecheck && npm run swagger && npm run test",
    "dev": "NODE_ENV=development tsx watch src/app.ts",
    "start": "NODE_ENV=production node dist/src/app.js",
    "prebuild": "npm run swagger",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "swagger": "tsx scripts/generate-swagger.ts",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:mock:push": "bash -c 'source .env && DATABASE_URL=$MOCK_DATABASE_URL prisma db push'",
    "db:mock:studio": "bash -c 'source .env && DATABASE_URL=$MOCK_DATABASE_URL prisma studio'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "lint:fix": "npm run format && eslint --fix \"src/**/*.{ts,js}\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@tsoa/cli": "^7.0.0-alpha.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "@types/yaml": "^1.9.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tsoa/runtime": "^7.0.0-alpha.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "node-cron": "^4.6.0",
    "onnxruntime-node": "^1.27.0",
    "openai": "^6.45.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "typedi": "^0.10.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  }
}
