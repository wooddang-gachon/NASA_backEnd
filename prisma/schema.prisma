datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUM 선언 (v3 schema.sql 1:1 매핑)
// ==========================================

enum AuthProvider {
  LOCAL
  KAKAO
  GOOGLE
  APPLE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LogCategory {
  WATER
  EMOTION
  JOURNAL
  EXERCISE
}

enum PlanetType {
  MEAL
  WATER
  EMOTION
  LIFESTYLE
  RETROSPECT
}

enum TravelStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Sender {
  USER
  TAMMY
  TAMMY_AI
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum EmotionState {
  HAPPY
  SAD
  ANGRY
  STRESSED
  CALM
}

enum ActivityType {
  BODY_SPEC
  EXERCISE
  MEAL
  WATER
  EMOTION
}

enum TriggerType {
  NEG_EMOTION
  NO_WATER
  NO_EXERCISE
  SYSTEM
}

enum ProactiveStatus {
  PENDING
  SENT
  RESPONDED
  EXPIRED
}

enum ActionType {
  CLICK
  SCREEN_VIEW
  SCROLL
  TEXT_INPUT
  BUTTON_TAP
}

enum ChangeReason {
  MEAL_LOG
  WORKOUT_CHECK
  WATER_LOG
  MOOD_LOG
  CHAT_EMPATHY
  LEVEL_UP
  WARP
}

// ==========================================
// 2. MODEL 선언 (v3 schema.sql 1:1 매핑)
// ==========================================

model users {
  id                      Int                    @id @default(autoincrement())
  email                   String                 @unique @db.VarChar(255)
  password_hash           String?                @db.VarChar(255)
  auth_provider           AuthProvider           @default(LOCAL)
  nickname                String                 @db.VarChar(50)
  gender                  Gender?
  age                     Int?
  target_weight_kg        Decimal?               @db.Decimal(5, 2)
  preferred_exercise      String?                @db.VarChar(100)
  exercise_location       String?                @db.VarChar(50)
  preferred_exercise_time String?                @db.VarChar(50)
  water_goal_ml           Int?                   @default(2000)
  calorie_goal_kcal       Int?                   @default(2000)
  current_fuel            Int?                   @default(0)
  refresh_token           String?                @db.Text
  status                  UserStatus             @default(ACTIVE)
  last_login_at           DateTime?              @db.Timestamp(0)
  created_at              DateTime               @default(now()) @db.Timestamp(0)
  updated_at              DateTime               @default(now()) @updatedAt @db.Timestamp(0)

  // 1:1 관계
  tammy_statuses          tammy_statuses?

  // 1:N 관계
  user_body_logs          user_body_logs[]
  quick_logs              quick_logs[]
  exercise_logs           exercise_logs[]
  water_logs              water_logs[]
  emotion_logs            emotion_logs[]
  planet_travels          planet_travels[]
  meals                   meals[]
  chat_messages           chat_messages[]
  chat_message_archives  chat_message_archives[]
  long_term_memories      long_term_memories[]
  reports                 reports[]
  monthly_reports         monthly_reports[]
  activity_logs           activity_logs[]
  proactive_triggers      proactive_triggers[]
  user_action_logs        user_action_logs[]
  tammy_status_logs       tammy_status_logs[]

  @@index([email], map: "idx_user_email")
}

model tammy_statuses {
  user_id         Int      @id
  level           Int      @default(1)
  current_exp     Int      @default(0)
  empathy_index   Int      @default(0)
  health_index    Int      @default(0)
  activity_index  Int      @default(0)
  happiness_index Int      @default(0)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(0)

  user            users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_body_logs {
  id          BigInt   @id @default(autoincrement())
  user_id     Int
  height_cm   Decimal  @db.Decimal(5, 2)
  weight_kg   Decimal  @db.Decimal(5, 2)
  recorded_at DateTime @default(now()) @db.Timestamp(0)

  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, recorded_at(sort: Desc)], map: "idx_user_body_recorded")
}

model quick_logs {
  id               BigInt      @id @default(autoincrement())
  user_id          Int
  category         LogCategory
  amount           Int?
  emotion_type     String?     @db.VarChar(50)
  journal_content  String?     @db.Text
  duration_minutes Int?
  earned_fuel      Int         @default(10)
  created_at       DateTime    @default(now()) @db.Timestamp(0)

  user             users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "idx_quick_log_user_created")
}

model exercise_logs {
  id                   BigInt   @id @default(autoincrement())
  user_id              Int
  duration_minutes     Int      @default(0)
  burned_calories_kcal Int      @default(0)
  is_completed         Boolean  @default(true)
  memo                 String?  @db.VarChar(255)
  performed_at         DateTime @default(now()) @db.Timestamp(0)

  user                 users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, performed_at(sort: Desc)], map: "idx_user_exercise_performed")
}

model water_logs {
  id          BigInt   @id @default(autoincrement())
  user_id     Int
  intake_ml   Int      @default(250)
  recorded_at DateTime @default(now()) @db.Timestamp(0)

  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, recorded_at(sort: Desc)], map: "idx_user_water_recorded")
}

model emotion_logs {
  id            BigInt       @id @default(autoincrement())
  user_id       Int
  emotion_state EmotionState
  cause_summary String?      @db.VarChar(255)
  recorded_at   DateTime     @default(now()) @db.Timestamp(0)

  user          users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, recorded_at(sort: Desc)], map: "idx_user_emotion_recorded")
}

model planets {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  planet_type   PlanetType
  required_fuel Int        @default(100)
  description   String?    @db.Text
  created_at    DateTime   @default(now()) @db.Timestamp(0)

  // 1:1 특화 테이블 관계
  meal_planets       meal_planets?
  water_planets      water_planets?
  emotion_planets    emotion_planets?
  lifestyle_planets  lifestyle_planets?
  retrospect_planets retrospect_planets?

  // 1:N 관계
  planet_travels     planet_travels[]
}

model meal_planets {
  planet_id            Int     @id
  target_calories_kcal Int     @default(0)
  target_carbohydrate_g Decimal @default(0.00) @db.Decimal(5, 2)
  target_protein_g      Decimal @default(0.00) @db.Decimal(5, 2)
  target_fat_g          Decimal @default(0.00) @db.Decimal(5, 2)

  planet               planets @relation(fields: [planet_id], references: [id], onDelete: Cascade)
}

model water_planets {
  planet_id        Int     @id
  target_water_ml  Int     @default(2000)
  min_intake_count Int     @default(4)

  planet           planets @relation(fields: [planet_id], references: [id], onDelete: Cascade)
}

model emotion_planets {
  planet_id           Int     @id
  min_empathy_score   Int     @default(0)
  min_happiness_score Int     @default(0)

  planet              planets @relation(fields: [planet_id], references: [id], onDelete: Cascade)
}

model lifestyle_planets {
  planet_id               Int     @id
  target_workout_duration Int     @default(30)
  daily_routine_target    Int     @default(1)

  planet                  planets @relation(fields: [planet_id], references: [id], onDelete: Cascade)
}

model retrospect_planets {
  planet_id        Int     @id
  period_days      Int     @default(7)
  auto_trigger_cron String @default("0 0 * * 0") @db.VarChar(50)

  planet           planets @relation(fields: [planet_id], references: [id], onDelete: Cascade)
}

model planet_travels {
  id           BigInt       @id @default(autoincrement())
  user_id      Int
  planet_id    Int?
  planet_type  PlanetType
  fuel_spent   Int
  status       TravelStatus @default(IN_PROGRESS)
  started_at   DateTime     @default(now()) @db.Timestamp(0)
  completed_at DateTime?    @db.Timestamp(0)

  user         users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  planet       planets?     @relation(fields: [planet_id], references: [id], onDelete: SetNull)

  reports      reports?

  @@index([user_id, started_at(sort: Desc)], map: "idx_travel_user_started")
}

model foods {
  id                 Int          @id @default(autoincrement())
  name               String       @unique @db.VarChar(100)
  standard_serving_g Decimal      @default(100.00) @db.Decimal(6, 2)
  calories_kcal      Int          @default(0)
  carbohydrate_g     Decimal      @default(0.00) @db.Decimal(5, 2)
  protein_g          Decimal      @default(0.00) @db.Decimal(5, 2)
  fat_g              Decimal      @default(0.00) @db.Decimal(5, 2)
  vitamin_percent    Int          @default(0)
  mineral_percent    Int          @default(0)
  category           String?      @db.VarChar(50)
  created_at         DateTime     @default(now()) @db.Timestamp(0)

  meal_items         meal_items[]
}

model meals {
  id                   BigInt       @id @default(autoincrement())
  user_id              Int
  meal_type            MealType
  comment              String?      @db.VarChar(255)
  total_calories_kcal  Int          @default(0)
  total_carbohydrate_g Decimal      @default(0.00) @db.Decimal(5, 2)
  total_protein_g      Decimal      @default(0.00) @db.Decimal(5, 2)
  total_fat_g          Decimal      @default(0.00) @db.Decimal(5, 2)
  vitamin_percent      Int          @default(0)
  mineral_percent      Int          @default(0)
  registered_at        DateTime     @default(now()) @db.Timestamp(0)

  user                 users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  meal_items           meal_items[]
  meal_images          meal_images[]

  @@index([user_id, registered_at(sort: Desc)], map: "idx_user_meal_registered")
}

model meal_images {
  id         BigInt   @id @default(autoincrement())
  meal_id    BigInt
  image_url  String   @db.VarChar(255)
  is_cover   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)

  meal       meals    @relation(fields: [meal_id], references: [id], onDelete: Cascade)

  @@index([meal_id], map: "idx_meal_image_meal")
}

model meal_items {
  id               BigInt   @id @default(autoincrement())
  meal_id          BigInt
  food_id          Int?
  custom_food_name String   @db.VarChar(100)
  intake_gram      Decimal  @default(100.00) @db.Decimal(6, 2)
  calories_kcal    Int      @default(0)
  carbohydrate_g   Decimal  @default(0.00) @db.Decimal(5, 2)
  protein_g        Decimal  @default(0.00) @db.Decimal(5, 2)
  fat_g            Decimal  @default(0.00) @db.Decimal(5, 2)

  meal             meals    @relation(fields: [meal_id], references: [id], onDelete: Cascade)
  food             foods?   @relation(fields: [food_id], references: [id], onDelete: SetNull)
}

model chat_messages {
  id           BigInt   @id @default(autoincrement())
  user_id      Int
  sender       Sender
  message_text String   @db.Text
  motion_tag   String?  @db.VarChar(50)
  is_deleted   Boolean  @default(false)
  is_edited    Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(0)

  user         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  chat_message_edits chat_message_edits[]

  @@index([user_id, created_at(sort: Desc)], map: "idx_user_msg_created")
}

model chat_message_edits {
  id              BigInt        @id @default(autoincrement())
  chat_message_id BigInt
  previous_text   String        @db.Text
  edited_at       DateTime      @default(now()) @db.Timestamp(0)

  chat_message    chat_messages @relation(fields: [chat_message_id], references: [id], onDelete: Cascade)
}

model chat_message_archives {
  id              BigInt   @id @default(autoincrement())
  user_id         Int
  chat_message_id BigInt?
  sender          Sender
  message_text    String   @db.Text
  raw_payload     Json?
  created_at      DateTime @db.Timestamp(0)
  archived_at     DateTime @default(now()) @db.Timestamp(0)

  user            users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  long_term_memories long_term_memories[]

  @@index([user_id, created_at(sort: Desc)], map: "idx_archive_user_created")
}

model long_term_memories {
  id                      Int                    @id @default(autoincrement())
  user_id                 Int
  chat_message_archive_id BigInt?
  category                String                 @db.VarChar(50)
  memory_content          String                 @db.Text
  importance_score        Int                    @default(1)
  updated_at              DateTime               @default(now()) @updatedAt @db.Timestamp(0)

  user                    users                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  archive                 chat_message_archives? @relation(fields: [chat_message_archive_id], references: [id], onDelete: SetNull)

  @@unique([user_id, category], map: "uq_user_category")
}

model reports {
  id               BigInt         @id @default(autoincrement())
  user_id          Int
  planet_travel_id BigInt?        @unique
  planet_type      PlanetType
  title            String         @db.VarChar(255)
  summary_content  String         @db.Text
  recommendations  String         @db.Text
  created_at       DateTime       @default(now()) @db.Timestamp(0)

  user             users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  planet_travel    planet_travels? @relation(fields: [planet_travel_id], references: [id], onDelete: SetNull)
}

model monthly_reports {
  id                Int      @id @default(autoincrement())
  user_id           Int
  report_year_month String   @db.Char(7)
  health_score      Int      @default(0)
  summary_content   String?  @db.Text
  aggregated_data   Json?
  created_at        DateTime @default(now()) @db.Timestamp(0)

  user              users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, report_year_month], map: "uq_user_month")
}

model activity_logs {
  id               BigInt       @id @default(autoincrement())
  user_id          Int
  activity_type    ActivityType
  activity_details Json
  recorded_at      DateTime     @default(now()) @db.Timestamp(0)

  user             users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, recorded_at(sort: Desc)], map: "idx_user_activity_recorded")
}

model proactive_triggers {
  id           BigInt          @id @default(autoincrement())
  user_id      Int
  trigger_type TriggerType
  reference_id BigInt?
  message_text String          @db.Text
  status       ProactiveStatus @default(PENDING)
  created_at   DateTime        @default(now()) @db.Timestamp(0)

  user         users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "idx_user_trigger_created")
}

model user_action_logs {
  id                BigInt     @id @default(autoincrement())
  user_id           Int
  screen_name       String     @db.VarChar(100)
  action_type       ActionType
  target_element_id String?    @db.VarChar(100)
  metadata          Json?
  created_at        DateTime   @default(now()) @db.Timestamp(0)

  user              users      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "idx_action_user_created")
}

model tammy_status_logs {
  id                 BigInt       @id @default(autoincrement())
  user_id            Int
  change_reason      ChangeReason
  delta_exp          Int          @default(0)
  delta_empathy      Int          @default(0)
  delta_health       Int          @default(0)
  delta_activity     Int          @default(0)
  delta_happiness    Int          @default(0)
  snapshot_level     Int
  snapshot_total_exp Int
  created_at         DateTime     @default(now()) @db.Timestamp(0)

  user               users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "idx_tammy_log_user_created")
}
